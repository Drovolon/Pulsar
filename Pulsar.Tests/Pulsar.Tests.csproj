<?xml version="1.0" encoding="utf-8"?>
<!-- Dalamud.NET.Sdk (not plain Microsoft.NET.Sdk) so DalamudLibPath and the Dalamud
     assembly references resolve exactly like they do for the plugin project. -->
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsPackable>false</IsPackable>

    <!-- NAudio.WinForms and Microsoft.VisualStudio.Threading.Only (via StreamJsonRpc)
         carry Microsoft.WindowsDesktop.App framework references, which the Linux test
         host can't satisfy. No WinForms/WPF code path runs in tests. Trade-off: this
         drops ALL transitive framework refs - a future package that legitimately needs
         one will fail at runtime and should be referenced directly here. -->
    <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- Direct ref (Common's version) so the JsonRpcContract proxy generator runs for
         test-defined RPC interfaces (IPingTarget); transitive refs don't run generators
         reliably. -->
    <PackageReference Include="StreamJsonRpc" Version="2.25.29" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pulsar\Pulsar.csproj" />
    <ProjectReference Include="..\Pulsar.AudioHost\Pulsar.AudioHost.csproj" />
    <ProjectReference Include="..\Pulsar.TranscodeHost\Pulsar.TranscodeHost.csproj" />
    <ProjectReference Include="..\Pulsar.Tests.StubHost\Pulsar.Tests.StubHost.csproj" />
  </ItemGroup>

  <!-- The stub host must exist as a RUNNABLE apphost next to the tests. A bare
       ProjectReference only copies the .dll; this copies the whole output (apphost,
       runtimeconfig, deps) into stubhost/. ItemGroup lives INSIDE the target: a
       top-level glob evaluates before StubHost is built and copies nothing on a
       clean first build (the Pulsar.csproj host-copy lesson). -->
  <Target Name="CopyStubHost" AfterTargets="Build">
    <ItemGroup>
      <!-- Forward slashes: a backslash ** glob silently matches nothing on Linux. -->
      <StubHostFiles Include="$(MSBuildThisFileDirectory)../Pulsar.Tests.StubHost/bin/$(Configuration)/net10.0-windows10.0.19041.0/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(StubHostFiles)" DestinationFolder="$(OutputPath)stubhost\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- The SDK marks Dalamud references Private=false (the game provides them at runtime).
       The test host has no game, so flip the ones our code paths actually load to copy-local. -->
  <ItemGroup>
    <Reference Update="Dalamud" Private="true" />
    <Reference Update="Dalamud.Bindings.ImGui" Private="true" />
    <Reference Update="Newtonsoft.Json" Private="true" />
    <Reference Update="Lumina" Private="true" />
  </ItemGroup>

</Project>
