<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Deliberately NO RuntimeIdentifier, unlike the real hosts (which pin win-x64 to
             get a PE for Wine): this stub must RUN on the machine executing the tests, so
             building on Linux emits a Linux ELF apphost. -->

        <!-- Same trade-off as Pulsar.Tests.csproj: Pulsar.Common's NAudio deps carry a
             WindowsDesktop framework reference the Linux runtime can't satisfy, and no
             WinForms/WPF code path runs here. -->
        <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
    </PropertyGroup>
    <ItemGroup>
        <!-- Direct ref so the JsonRpcContract proxy generator runs in this assembly. -->
        <PackageReference Include="StreamJsonRpc" Version="2.25.29"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Pulsar.Common\Pulsar.Common.csproj"/>
    </ItemGroup>
</Project>
